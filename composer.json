{
    "name": "sulu/article-view-document-bundle",
    "description": "Sulu bundle as a BC-layer for the article-view-document.",
    "type": "sulu-bundle",
    "license": "MIT",
    "require": {
        "php": "^7.2 || ^8.0",
        "sulu/sulu": "^3.0@dev"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^1.1",
        "jangregor/phpstan-prophecy": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^8.0",
        "php-cs-fixer/shim": "^3.0",
        "jackalope/jackalope-doctrine-dbal": "^1.3.4",
        "phpspec/prophecy": "^1.10"
    },
    "keywords": [
        "redirects"
    ],
    "authors": [
        {
            "name": "Sulu ArticleViewDocument Bundle",
            "homepage": "https://github.com/sulu/SuluArticleViewDocumentBundle/contributors"
        }
    ],
    "homepage": "https://github.com/sulu/SuluArticleViewDocumentBundle",
    "autoload": {
        "psr-4": {
            "Sulu\\Bundle\\ArticleViewDocumentBundle\\": ""
        }
    },
    "scripts": {
        "lint": [
            "@phpstan",
            "@php-cs"
        ],
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "phpstan": [
            "vendor/bin/phpstan analyse"
        ],
        "php-cs": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "php-cs-fix": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
