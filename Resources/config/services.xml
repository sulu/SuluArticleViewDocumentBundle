<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Document Factory & Repository -->
        <service id="sulu_article_view_document.document.factory.document_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\DocumentFactory">
            <argument>%sulu_article.documents%</argument>
        </service>

        <service id="sulu_article_view_document.document.repository.article_view_document_repository" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Repository\ArticleViewDocumentRepository">
            <argument type="service" id="es.manager" />
            <argument type="service" id="sulu_article_view_document.document.factory.document_factory" />
        </service>

        <!-- builder -->
        <service id="sulu_article_view_document.builder.index" class="Sulu\Bundle\ArticleViewDocumentBundle\Builder\ArticleIndexBuilder">
            <tag name="massive_build.builder" />
        </service>

        <!-- annotation reader -->
        <service id="sulu_article_view_document.annotations.cached_reader"
                 decorates="es.annotations.cached_reader"
                 class="Sulu\Bundle\ArticleViewDocumentBundle\Elasticsearch\AnnotationReader">
            <argument type="service" id="sulu_article_view_document.annotations.cached_reader.inner"/>
            <argument type="string">%sulu_article.view_document.article.class%</argument>
        </service>

        <!-- Factory Services -->
        <service id="sulu_article_view_document.document.index.factory.excerpt_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\ExcerptFactory">
            <argument type="service" id="sulu_article_view_document.document.index.factory.category_collection_factory" />
            <argument type="service" id="sulu_article_view_document.document.index.factory.tag_collection_factory" />
            <argument type="service" id="sulu_article_view_document.document.index.factory.media_collection_factory" />
            <argument type="service" id="sulu_article_view_document.document.index.factory.segment_collection_factory" />
        </service>

        <service id="sulu_article_view_document.document.index.factory.seo_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\SeoFactory" />

        <service id="sulu_article_view_document.document.index.factory.category_collection_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\CategoryCollectionFactory">
            <argument type="service" id="sulu.repository.category" />
            <argument type="service" id="sulu_category.category_manager" />
        </service>

        <service id="sulu_article_view_document.document.index.factory.tag_collection_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\TagCollectionFactory">
            <argument type="service" id="sulu_tag.tag_manager" />
        </service>

        <service id="sulu_article_view_document.document.index.factory.media_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\MediaFactory">
            <argument type="service" id="sulu_media.media_manager" />
        </service>

        <service id="sulu_article_view_document.document.index.factory.media_collection_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\MediaCollectionFactory">
            <argument type="service" id="sulu_media.media_manager" />
        </service>

        <service id="sulu_article_view_document.document.index.factory.segment_collection_factory" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\Factory\SegmentCollectionFactory">
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <!-- Resolver Services -->
        <service id="sulu_article_view_document.webspace_settings_configuration_resolver"
                 class="Sulu\Bundle\ArticleViewDocumentBundle\DependencyInjection\WebspaceSettingsConfigurationResolver">
            <argument>%sulu_article.default_main_webspace%</argument>
            <argument>%sulu_article.default_additional_webspaces%</argument>
        </service>
        <service id="sulu_article_view_document.document.resolver.webspace_resolver" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Resolver\WebspaceResolver">
            <argument type="service" id="sulu_core.webspace.webspace_manager" />
            <argument type="service" id="sulu_article_view_document.webspace_settings_configuration_resolver" />
        </service>

        <!-- Indexer Services -->
        <!-- Draft/Default indexer (used in admin context) -->
        <service id="sulu_article_view_document.document.index.article_draft_indexer" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\ArticleGhostIndexer">
            <argument type="service" id="sulu_page.structure.factory" />
            <argument type="service" id="sulu_security.user_manager" />
            <argument type="service" id="sulu.repository.contact" />
            <argument type="service" id="sulu_article_view_document.document.factory.document_factory" />
            <argument type="service" id="es.manager.default" />  <!-- Use default manager for draft -->
            <argument type="service" id="sulu_article_view_document.document.index.factory.excerpt_factory" />
            <argument type="service" id="sulu_article_view_document.document.index.factory.seo_factory" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="translator" />
            <argument type="service" id="sulu_article_view_document.document.resolver.webspace_resolver" />
            <argument type="collection">
                <argument key="default">
                    <argument key="translation_key">sulu_article.type.default</argument>
                </argument>
            </argument>
            <argument type="service" id="sulu_core.webspace.webspace_manager" />
            <argument type="service" id="sulu_article.article_repository" />
            <argument type="service" id="sulu_content.content_manager" />
        </service>

        <!-- Live indexer (used in website context) -->
        <service id="sulu_article_view_document.document.index.article_live_indexer" class="Sulu\Bundle\ArticleViewDocumentBundle\Document\Index\ArticleIndexer">
            <argument type="service" id="sulu_page.structure.factory" />
            <argument type="service" id="sulu_security.user_manager" />
            <argument type="service" id="sulu.repository.contact" />
            <argument type="service" id="sulu_article_view_document.document.factory.document_factory" />
            <argument type="service" id="es.manager.live" />  <!-- Use live manager for published content -->
            <argument type="service" id="sulu_article_view_document.document.index.factory.excerpt_factory" />
            <argument type="service" id="sulu_article_view_document.document.index.factory.seo_factory" />
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="translator" />
            <argument type="service" id="sulu_article_view_document.document.resolver.webspace_resolver" />
            <argument type="collection">
                <argument key="default">
                    <argument key="translation_key">sulu_article.type.default</argument>
                </argument>
            </argument>
        </service>

        <!-- Commands -->
        <service id="sulu_article_view_document.command.reindex_command" class="Sulu\Bundle\ArticleViewDocumentBundle\Command\ReindexCommand">
            <argument type="service" id="sulu_core.webspace.webspace_manager" />
            <argument type="service" id="sulu_article.article_repository" />
            <argument type="service" id="sulu_content.content_manager" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="sulu_article_view_document.document.index.article_draft_indexer" /> <!-- Draft indexer for admin context -->
            <argument type="service" id="sulu_article_view_document.document.index.article_live_indexer" /> <!-- Live indexer for website context -->
            <argument>%sulu.context%</argument>
            <tag name="console.command" />
        </service>
    </services>
</container>
